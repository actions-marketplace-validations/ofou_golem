#!/usr/bin/env bash
# Lint this project's Python: the package, the tests, and scripts/.
# Evidence snapshots and .golem run artifacts are left out.
#
#   scripts/ruff            # ruff check
#   scripts/ruff --fix
#   scripts/ruff format
set -euo pipefail
cd "$(dirname "$0")/.."

paths=(golem tests scripts)
if [ $# -eq 0 ] || [[ "$1" == -* ]]; then
  exec uv run ruff check "${paths[@]}" "$@"
fi
exec uv run ruff "$@" "${paths[@]}"
